# ESP32-S3-ETH (Waveshare design): ESP32-S3R8 with 16 MB flash and 8 MB octal PSRAM,
# W5500 Ethernet (PoE), OV2640/OV5640 camera, microSD (SDMMC 1-line).
# Applied after sdkconfig.defaults (see CMakeLists.txt) and overrides the ESP32-CAM values there.

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Octal PSRAM of the ESP32-S3R8
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=n
CONFIG_SPIRAM_SPEED_80M=y

# Ethernet: W5500 on SPI
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
